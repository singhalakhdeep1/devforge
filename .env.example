# Settings for `docker compose up` (copied to .env). Connection settings between containers are set
# in docker-compose.yml; this file holds secrets and the optional integrations.

# ── required: long random values ──
JWT_ACCESS_SECRET=change-me-to-64-random-characters
INTERNAL_API_KEY=change-me-to-another-long-random-value
# encrypts two-factor secrets at rest (any long random value)
ENCRYPTION_KEY=change-me-to-a-third-long-random-value

# ── databases and storage ──
POSTGRES_USER=devforge
POSTGRES_PASSWORD=devforge
MINIO_ROOT_USER=devforge
MINIO_ROOT_PASSWORD=devforge-minio-secret

# ── public addresses ──
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# the IP browsers use to reach this machine for call media (127.0.0.1 = this computer only)
MEDIASOUP_ANNOUNCED_IP=127.0.0.1

# ── event bus: empty = Redis Streams; kafka:9092 with `--profile kafka` ──
KAFKA_BROKERS=

# ── email: Mailpit catches everything locally; set real SMTP or SendGrid for production ──
EMAIL_FROM=DevForge <noreply@devforge.dev>
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=

# ── payments (optional; disabled when empty) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# ── sign in with Google / GitHub (optional) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── code execution for languages other than JavaScript (optional) ──
PISTON_URL=

# ── backups ──
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_MIN=5

# ── alerts from monitoring-service (optional) ──
ALERT_EMAILS=
SLACK_WEBHOOK_URL=
