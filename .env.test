# Test Environment Variables
NODE_ENV=test

# Database (use separate test database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devhub_test
MONGODB_URI=mongodb://localhost:27017/devhub_test
REDIS_URL=redis://localhost:6379/1
ELASTICSEARCH_URL=http://localhost:9200

# JWT
JWT_SECRET=test-jwt-secret-key-for-testing
JWT_EXPIRES_IN=7d

# API Keys (use test keys)
SENDGRID_API_KEY=test-sendgrid-key
AWS_ACCESS_KEY_ID=test-aws-key
AWS_SECRET_ACCESS_KEY=test-aws-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=test-bucket
STRIPE_SECRET_KEY=sk_test_mock_key
STRIPE_PUBLISHABLE_KEY=pk_test_mock_key
STRIPE_WEBHOOK_SECRET=whsec_test_mock_secret

# Service URLs
AUTH_SERVICE_URL=http://localhost:3001
EMAIL_SERVICE_URL=http://localhost:3002
WEBSOCKET_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004
FILE_SERVICE_URL=http://localhost:3005
ANALYTICS_SERVICE_URL=http://localhost:3006
SEARCH_SERVICE_URL=http://localhost:3007
VIDEO_SERVICE_URL=http://localhost:3008
EDITOR_SERVICE_URL=http://localhost:3009
PAYMENT_SERVICE_URL=http://localhost:3010
KANBAN_SERVICE_URL=http://localhost:3011
GRAPHQL_API_URL=http://localhost:3012

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=error
