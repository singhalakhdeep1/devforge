# --- Required ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/devforge
# Two different random strings, at least 16 characters each:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_EXPIRY=15m
REFRESH_TOKEN_DAYS=7
# Set to true only if the frontend and API are on different sites (cookie becomes SameSite=None; Secure)
CROSS_SITE_COOKIES=false
UPLOAD_DIR=uploads

# --- Email (optional: without it, verification and reset links are printed to the server log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=DevForge <noreply@example.com>

# --- Paid courses (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Server-side code execution for non-JavaScript languages (optional) ---
# Base URL of a Piston server, e.g. http://localhost:2000 (https://github.com/engineer-man/piston)
PISTON_URL=

# --- Seed only: also create an admin account ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
