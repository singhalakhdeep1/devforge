{
  "name": "@devhub/backup-service",
  "version": "2.0.0",
  "private": true,
  "description": "Scheduled and on-demand backups (pg_dump / mongodump) with retention and restore",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
