{
  "name": "@devhub/editor-service",
  "version": "2.0.0",
  "private": true,
  "description": "Collaborative documents on Yjs (CRDT) over WebSocket, snapshots, export; code snippets and sandboxed execution",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "generate": "prisma generate",
    "build": "prisma generate && tsc && node ../../scripts/copy-generated.mjs",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@devhub/shared": "*",
    "@prisma/client": "^5.22.0",
    "express": "^4.21.2",
    "lib0": "^0.2.99",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.14",
    "@types/ws": "^8.5.13",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
