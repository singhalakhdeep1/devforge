{
  "name": "@devhub/email-service",
  "version": "2.0.0",
  "private": true,
  "description": "Transactional email: event-driven BullMQ queue with retries, handlebars templates, SendGrid / SMTP / dev-log transports",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@devhub/shared": "*",
    "@sendgrid/mail": "^8.1.4",
    "bullmq": "^5.34.2",
    "express": "^4.21.2",
    "handlebars": "^4.7.8",
    "nodemailer": "^6.9.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.14",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
