{
  "name": "@devhub/file-service",
  "version": "2.0.0",
  "private": true,
  "description": "File uploads with ownership and quotas, avatar processing, local-disk or S3 storage",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "generate": "prisma generate",
    "build": "prisma generate && tsc && node ../../scripts/copy-generated.mjs",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.723.0",
    "@aws-sdk/s3-request-presigner": "^3.723.0",
    "@devhub/shared": "*",
    "@prisma/client": "^5.22.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.14",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
