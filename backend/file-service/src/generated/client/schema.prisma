// File metadata. The bytes live in the storage driver (local disk or S3); this table says who owns what.
// Lives in its own Postgres schema ("file").

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("FILE_DATABASE_URL")
}

enum FileVisibility {
  PRIVATE
  PUBLIC
}

model File {
  id         String         @id @default(uuid())
  ownerId    String
  name       String
  mimeType   String
  size       Int
  /// storage key, e.g. files/<owner>/<id>
  key        String         @unique
  visibility FileVisibility @default(PRIVATE)
  createdAt  DateTime       @default(now())

  @@index([ownerId, createdAt])
}
