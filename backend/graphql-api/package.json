        "graphql-scalars": "^1.22.4",
        "dataloader": "^2.2.2",
        "redis": "^4.6.12",
        "dotenv": "^16.3.1",
        "winston": "^3.11.0",
        "graphql-subscriptions": "^2.0.0",
