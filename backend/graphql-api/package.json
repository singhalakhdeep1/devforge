{
  "name": "@devhub/graphql-api",
  "version": "2.0.0",
  "private": true,
  "description": "GraphQL API (Apollo Server) over every DevForge service, with live subscriptions over graphql-ws",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express4": "^1.1.1",
    "@devhub/graphql-subscriptions": "*",
    "@devhub/shared": "*",
    "@graphql-tools/schema": "^10.0.16",
    "express": "^4.21.2",
    "graphql": "^16.10.0",
    "graphql-scalars": "^1.24.0",
    "graphql-ws": "^5.16.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.14",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
