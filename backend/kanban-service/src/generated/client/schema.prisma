// Kanban boards: columns with WIP limits, tasks with fractional ordering, sprints, epics, labels,
// comments, attachments, time tracking and an activity log. Lives in its own Postgres schema ("kanban").
// Who may do what is decided by the owning project (project-service); this service stores no roles.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("KANBAN_DATABASE_URL")
}

enum BoardVisibility {
  PRIVATE
  PUBLIC
}

enum TaskType {
  TASK
  STORY
  BUG
  SUBTASK
}

enum Priority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model UserRef {
  id        String   @id
  name      String
  avatar    String?
  updatedAt DateTime @updatedAt
}

model Board {
  id          String          @id @default(uuid())
  projectId   String
  name        String
  description String?
  /// short prefix for task keys, e.g. "WEB" gives WEB-1, WEB-2
  keyPrefix   String
  /// last task number handed out; incremented atomically so keys never collide
  lastNumber  Int             @default(0)
  visibility  BoardVisibility @default(PRIVATE)
  createdBy   String
  archived    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  columns  Column[]
  tasks    Task[]
  sprints  Sprint[]
  epics    Epic[]
  labels   Label[]
  activity Activity[]

  @@index([projectId])
}

model Column {
  id        String     @id @default(uuid())
  boardId   String
  name      String
  color     String     @default("#6b7280")
  /// moving a task into this column sets the task to this status
  status    TaskStatus @default(TODO)
  order     Float
  /// work-in-progress limit; null means unlimited
  wipLimit  Int?
  createdAt DateTime   @default(now())

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId, order])
}

model Task {
  id             String     @id @default(uuid())
  boardId        String
  columnId       String
  sprintId       String?
  epicId         String?
  parentId       String?
  number         Int
  key            String
  title          String
  description    String?
  type           TaskType   @default(TASK)
  priority       Priority   @default(MEDIUM)
  status         TaskStatus @default(TODO)
  points         Int?
  estimatedHours Float?
  /// fractional position inside the column: moving a card only rewrites that one card
  order          Float
  dueDate        DateTime?
  completedAt    DateTime?
  assigneeId     String?
  reporterId     String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  board       Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column      Column        @relation(fields: [columnId], references: [id])
  sprint      Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epic        Epic?         @relation(fields: [epicId], references: [id], onDelete: SetNull)
  parent      Task?         @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]        @relation("Subtasks")
  labels      TaskLabel[]
  comments    Comment[]
  attachments Attachment[]
  timeEntries TimeEntry[]
  watchers    TaskWatcher[]

  @@unique([boardId, number])
  @@index([boardId, columnId, order])
  @@index([assigneeId])
  @@index([sprintId])
  @@index([epicId])
  @@index([parentId])
}

model Sprint {
  id              String       @id @default(uuid())
  boardId         String
  name            String
  goal            String?
  startDate       DateTime
  endDate         DateTime
  status          SprintStatus @default(PLANNED)
  committedPoints Int?
  completedPoints Int?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId, status])
}

model Epic {
  id          String   @id @default(uuid())
  boardId     String
  name        String
  description String?
  color       String   @default("#7c3aed")
  createdAt   DateTime @default(now())

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId])
}

model Label {
  id        String   @id @default(uuid())
  boardId   String
  name      String
  color     String
  createdAt DateTime @default(now())

  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks TaskLabel[]

  @@unique([boardId, name])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   String
  mentions  String[]
  edited    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

/// An attachment: the bytes live in the file-service.
model Attachment {
  id        String   @id @default(uuid())
  taskId    String
  fileId    String
  name      String
  mimeType  String
  size      Int
  addedBy   String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, fileId])
}

model TimeEntry {
  id          String   @id @default(uuid())
  taskId      String
  userId      String
  hours       Float
  description String?
  date        DateTime
  createdAt   DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId, date])
}

model TaskWatcher {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Activity {
  id        String   @id @default(uuid())
  boardId   String
  taskId    String?
  userId    String
  action    String
  /// what changed, e.g. { field: "assignee", from: "...", to: "..." }
  detail    Json     @default("{}")
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, createdAt])
  @@index([taskId, createdAt])
}
