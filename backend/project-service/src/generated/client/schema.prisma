// Projects, teams and the social layer around them (comments, stars, follows, invitations, activity).
// Lives in its own Postgres schema ("project"). People are referenced by id; display names come from
// the UserRef read-model that the auth-service events keep current.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("PROJECT_DATABASE_URL")
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
  TEAM
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationType {
  PROJECT
  TEAM
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

/// Display data for people, synced from user.* events (never credentials, never email).
model UserRef {
  id        String   @id
  name      String
  avatar    String?
  updatedAt DateTime @updatedAt
}

model Team {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  ownerId     String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  TeamMember[]
  projects Project[]

  @@index([ownerId])
}

model TeamMember {
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

model Project {
  id           String            @id @default(uuid())
  name         String
  slug         String            @unique
  description  String?
  readme       String?
  visibility   ProjectVisibility @default(PRIVATE)
  status       ProjectStatus     @default(ACTIVE)
  ownerId      String
  teamId       String?
  tags         String[]
  coverImage   String?
  repoUrl      String?
  forkedFromId String?
  forkCount    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  team       Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  forkedFrom Project?        @relation("Forks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks      Project[]       @relation("Forks")
  members    ProjectMember[]
  comments   Comment[]
  likes      Like[]
  files      ProjectFile[]

  @@index([ownerId])
  @@index([visibility, status, updatedAt])
  @@index([teamId])
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  projectId String
  userId    String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("Replies")

  @@index([projectId, createdAt])
  @@index([parentId])
}

model Like {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

model Invitation {
  id        String           @id @default(uuid())
  email     String
  senderId  String
  type      InvitationType
  entityId  String
  /// role to grant on acceptance (a ProjectRole or TeamRole name)
  role      String
  status    InvitationStatus @default(PENDING)
  tokenHash String           @unique
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@index([email, status])
  @@index([entityId])
}

/// An attachment: the bytes live in the file-service, this row says which project they belong to.
model ProjectFile {
  id        String   @id @default(uuid())
  projectId String
  fileId    String
  name      String
  mimeType  String
  size      Int
  addedBy   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, fileId])
}

model Activity {
  id         String   @id @default(uuid())
  userId     String
  type       String
  entityType String
  entityId   String
  /// project the activity belongs to, if any, for per-project feeds
  projectId  String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}
