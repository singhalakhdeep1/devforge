{
  "name": "@devhub/reporting-service",
  "version": "2.0.0",
  "private": true,
  "description": "Reports built from every domain's statistics: JSON, CSV, Excel and PDF, on demand or on a schedule",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "generate": "prisma generate",
    "build": "prisma generate && tsc && node ../../scripts/copy-generated.mjs",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@devhub/shared": "*",
    "@prisma/client": "^5.22.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.14",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.8",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
