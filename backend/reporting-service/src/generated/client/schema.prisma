// Scheduled reports and the files they produced. Lives in its own Postgres schema ("reporting").

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("REPORTING_DATABASE_URL")
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
}

model Schedule {
  id         String    @id @default(uuid())
  ownerId    String
  type       String
  format     String
  days       Int       @default(30)
  frequency  Frequency
  /// UTC hour of day the report runs
  hourUtc    Int       @default(6)
  /// who gets an "it is ready" email (the report itself is downloaded from the app)
  recipients String[]
  /// for the instructor report: whose courses
  subjectId  String?
  enabled    Boolean   @default(true)
  nextRunAt  DateTime
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())

  runs Run[]

  @@index([enabled, nextRunAt])
  @@index([ownerId])
}

model Run {
  id         String   @id @default(uuid())
  scheduleId String?
  ownerId    String
  type       String
  format     String
  days       Int
  filename   String
  mimeType   String
  size       Int
  status     String   @default("OK")
  /// sections that could not be built because a service was unreachable
  missing    String[]
  error      String?
  data       Bytes?
  createdAt  DateTime @default(now())

  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
}
