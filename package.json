{
  "name": "devforge",
  "version": "2.0.0",
  "description": "DevForge: developer platform. Courses and learning, projects, kanban boards, collaborative editor, video rooms, payments. Microservices behind an API gateway.",
  "private": true,
  "workspaces": [
    "backend/shared",
    "backend/auth-service",
    "backend/course-service",
    "backend/api-gateway",
    "backend/notification-service",
    "websocket-server",
    "backend/payment-service",
    "backend/editor-service",
    "backend/file-service",
    "backend/elasticsearch-service",
    "backend/search-service",
    "backend/email-service",
    "backend/analytics-service",
    "backend/project-service",
    "backend/kanban-service"
  ],
  "scripts": {
    "build:shared": "npm run build -w @devhub/shared",
    "build": "npm run build:shared && npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:frontend": "npm --prefix frontend run dev",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  }
}
