{
  "name": "@devhub/websocket-server",
  "version": "2.0.0",
  "private": true,
  "description": "Realtime hub: authenticated Socket.IO with a Redis adapter, user channels, editor rooms, pub/sub bridge from services",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@devhub/shared": "*",
    "@socket.io/redis-adapter": "^8.3.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
